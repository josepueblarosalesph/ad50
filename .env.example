APP_NAME="AD+50"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En local se deja en "log": los mensajes quedan escritos en
# storage/logs/laravel.log y no se envía nada de verdad.
# En producción se usa Resend por SMTP (ver el bloque comentado abajo).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@adconsulting.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Producción (Resend, SMTP). MAIL_PASSWORD es la API key de Resend (empieza con re_)
# y el remitente debe pertenecer a un dominio verificado en Resend.
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_tu_api_key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Flow (pasarela de pago). Sandbox: https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api

# Extractor de CV: quién lee el PDF del postulante para prellenar su ficha.
# Sin la api_key del proveedor elegido, el autocompletado no se ofrece.
# Ojo: la lectura corre en la cola, así que necesita un worker (php artisan queue:work).
EXTRACTOR_CV_PROVEEDOR=gemini

# Gemini (Google AI Studio): saca la key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.7-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5
